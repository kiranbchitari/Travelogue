<resources>
    <style name="Theme.Travelogue" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Travelogue.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="splashMark">@color/splash_mark</item>
        <item name="splashAccent">@color/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Travelogue</item>
    </style>
</resources>
