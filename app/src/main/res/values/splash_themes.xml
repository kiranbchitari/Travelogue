<?xml version="1.0" encoding="utf-8"?>
<!--
  One start-up screen per theme, each in three forms: following the system's light/dark setting,
  and fixed light or dark for when the app's brightness is set by hand. MainActivity tells Android
  which one to use (Android 12 and later). Android remembers the choice by style name, so these
  names must not change.
-->
<resources>
    <attr name="splashMark" format="color" />
    <attr name="splashAccent" format="color" />

    <style name="Theme.Travelogue.Splash.Classic">
        <item name="windowSplashScreenBackground">@color/splash_classic_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="splashMark">@color/splash_classic_mark</item>
        <item name="splashAccent">@color/splash_classic_accent</item>
    </style>
    <style name="Theme.Travelogue.Splash.Classic.Light">
        <item name="windowSplashScreenBackground">@color/splash_classic_bg_light</item>
        <item name="splashMark">@color/splash_classic_mark_light</item>
        <item name="splashAccent">@color/splash_classic_accent_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Travelogue.Splash.Classic.Dark">
        <item name="windowSplashScreenBackground">@color/splash_classic_bg_dark</item>
        <item name="splashMark">@color/splash_classic_mark_dark</item>
        <item name="splashAccent">@color/splash_classic_accent_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

